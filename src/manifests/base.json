{
	"manifest_version": 3,
	"name": "__MSG_name__",
	"short_name": "__MSG_short_name__",
	"author": "Edoardo Tosin",
	"description": "__MSG_description__",
	"homepage_url": "https://github.com/EdoardoTosin/Silly-Redirect-for-Zoom-Meetings",
	"default_locale": "en",
	"icons": {
		"16": "icons/16x16.png",
		"32": "icons/32x32.png",
		"48": "icons/48x48.png",
		"128": "icons/128x128.png",
		"256": "icons/256x256.png"
	},
	"permissions": [
		"storage"
	],
	"content_scripts": [
		{
			"matches": [
				"*://*.zoom.us/*",
				"*://*.zoomgov.com/*"
			],
			"exclude_matches": [
				"*://*.zoom.us/wc/*",
				"*://*.zoomgov.com/wc/*",
				"file://*/*"
			],
			"js": [
				"js/redirect.js"
			],
			"run_at": "document_start",
			"all_frames": false
		}
	],
	"action": {
		"default_icon": {
			"16": "icons/16x16.png",
			"32": "icons/32x32.png",
			"48": "icons/48x48.png",
			"64": "icons/64x64.png",
			"128": "icons/128x128.png",
			"256": "icons/256x256.png"
		},
		"default_title": "__MSG_name__",
		"default_popup": "html/popup.html"
	}
}
