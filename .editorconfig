root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.json]
indent_size = 2

# Manifests and locale files use tabs, matching their existing indentation.
[{src/manifests/**/*.json,src/_locales/**/*.json}]
indent_style = tab
